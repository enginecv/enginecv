# Committed on purpose (see the .gitignore exception). Production build values
# for public, non-secret settings. NEXT_PUBLIC_* are inlined at build time, so
# the Cloudflare build picks these up without dashboard variables.
#
# The AdSense publisher ID is public: it is served in /ads.txt and the
# google-adsense-account meta tag that verifies site ownership.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-3968492756394322
# Ads stay off until the certified CMP message and AdSense approval are done (#56).
NEXT_PUBLIC_ENABLE_ADS=false
# GitHub Sponsors profile approved 2026-10-28; shows Sponsors links next to Ko-fi.
NEXT_PUBLIC_GITHUB_SPONSORS_ENABLED=true
